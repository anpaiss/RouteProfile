<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_route_profile"
        android:label="@string/app_name">

        <!-- The Karoo fetches this manifest to show the extension's details and offer updates
             in its library: it must exist in every release (app/manifest.json as an asset). -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="https://github.com/anpaiss/RouteProfile/releases/latest/download/manifest.json" />

        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tap on the field while the ride is paused: the route's climbs -->
        <activity
            android:name=".ClimbsActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />

        <!-- Tap on the field: whole route / next 10 km -->
        <receiver
            android:name=".TapReceiver"
            android:exported="false" />

        <service
            android:name=".RouteProfileExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>
</manifest>

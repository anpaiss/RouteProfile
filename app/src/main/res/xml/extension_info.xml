<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/app_name"
    icon="@drawable/ic_route_profile"
    id="routeprofile"
    scansDevices="false">

    <DataType
        typeId="route-profile"
        displayName="@string/field_name"
        description="@string/field_desc"
        graphical="true"
        icon="@drawable/ic_route_profile" />

    <DataType
        typeId="to-climb"
        displayName="@string/f_to_climb_name"
        description="@string/f_to_climb_desc"
        graphical="true"
        icon="@drawable/ic_route_profile" />

    <DataType
        typeId="to-top"
        displayName="@string/f_to_top_name"
        description="@string/f_to_top_desc"
        graphical="true"
        icon="@drawable/ic_route_profile" />

    <DataType
        typeId="up-to-top"
        displayName="@string/f_up_to_top_name"
        description="@string/f_up_to_top_desc"
        graphical="true"
        icon="@drawable/ic_route_profile" />

    <DataType
        typeId="grade-to-top"
        displayName="@string/f_grade_to_top_name"
        description="@string/f_grade_to_top_desc"
        graphical="true"
        icon="@drawable/ic_route_profile" />

</ExtensionInfo>
